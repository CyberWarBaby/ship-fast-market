# Direct upstream URLs for the two mock third-party services.
# Shop calls these ONLY through the /api/shipfast and /api/payflex rewrites
# in next.config.js — never directly from the browser, and never through
# Kong / CipherGuard.

# ShipFast on Render (this is the live logistics API):
SHIPFAST_UPSTREAM_URL=https://shipfast-api.onrender.com

# PayFlex (not this repo — use local or the teammate's public URL):
PAYFLEX_UPSTREAM_URL=http://localhost:8006
